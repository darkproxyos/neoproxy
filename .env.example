NEOPROXY_API_URL=http://localhost:3000
EVENT_DB_PATH=./sqlite.db
# Chat real por agente en /proxyverse/[id] (app/api/proxyverse-chat). Sin esta
# key, el canal sigue funcionando con las líneas pre-escritas de agents.ts.
ANTHROPIC_API_KEY=

# Bypass temporal de login para /admin mientras el login real de producción
# está roto (ver scripts/reset-root-password.ts). OFF por default -- en
# cuanto esto es "true" (seteado con `vercel env add`, nunca por pipe),
# /admin/darkproxy no pide sesión para NADIE que tenga la URL, incluidas las
# acciones que escriben en la DB (purgar entropía, inyectar corrupción).
# Borrar esta variable en Vercel apenas el login real vuelva a funcionar.
NEXT_PUBLIC_ADMIN_BYPASS_AUTH=
